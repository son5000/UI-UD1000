			    	messageWindow("오류 : USB를 확인하세요.");
		    	} else if (data.responseText.indexOf("OK")>=0) {
		    		messageWindow("복사가 완료되었습니다.");
		    	}
		    }, 
		    error:function(request, status, error) {
		    }
		});
	}
}

function deleteFile() {
	var strIDList = "";
	$('input:checkbox[name="fileid"]').each(function() {
	    if(this.checked) {
			strIDList += this.value + ",";
    	}
	});
	if (strIDList != "") {
		$.ajax({
		    type: 'GET',
		    url:"/fileDelete?filelist="+strIDList, 
		    cache:false,
		    async:true,
		    complete:function(data) {
		    	fileWindow();
		    }, 
		    error:function(request, status, error) {
		    }
		});
	}
}

function closeFileWindow() {
	$.ajax({
	    type: 'GET',
	    url:"/fileMode?mode=STOP", 
	    cache:false,
	    async:true,
	    complete:function(data) {
	    }, 
	    error:function(request, status, error) {
	    }
	});
	$("#modalWindow").css('visibility', 'hidden');
	$("#fileWindow").css('visibility', 'hidden');
}

function closeWindow() {
	$("#modalWindow").css('visibility', 'hidden');
	$("#settingWindow").css('visibility', 'hidden');
	$("#messageWindow").css('visibility', 'hidden');
}

function closeMessageWindow() {
	if ($("#messageWindow").css('visibility') === "visible") {
		$("#modalWindow").css('visibility', 'hidden');
		$("#settingWindow").css('visibility', 'hidden');
		$("#messageWindow").css('visibility', 'hidden');
	}
}

var currShift = <%-global.config.get("audio.shift")%>;
var shiftMode = "";

function changeShift() {
	if (currShift == 10) {
		currShift = 1;
	} else if (currShift == 1) {
		currShift = 6;
	} else if (currShift == 6) {
		currShift = 10;
	} else {
		currShift = 10;
	}
	setShift();
}

function setShift() {
	if (currShift == 1) {
		shiftMode = "mode_audible.png";
	} else if (currShift == 6) {
		shiftMode = "mode_gas.png";
	} else {
		currShift = 10;
		shiftMode = "mode_elec.png";
	}
	$("div.mode img").attr("src", "/images/"+shiftMode);
	$.ajax({
	    type: 'GET',
	    url:"/setShift?shift="+currShift, 
	    cache:false,
	    async:true,
	    complete:function(data) {
	    }, 
	    error:function(request, status, error) {
	    }
	});
}

function updateTempRange() {
	if (currTempRange == 1) {
		$("#min_temp").text("10℃");
		$("#mid_temp").text("20℃");
		$("#max_temp").text("30℃");
		$("#min_btn").text("10℃");
		$("#max_btn").text("30℃");
	} else if (currTempRange == 2) {
		$("#min_temp").text("10℃");
		$("#mid_temp").text("30℃");
		$("#max_temp").text("50℃");
		$("#min_btn").text("10℃");
		$("#max_btn").text("50℃");
	} else if (currTempRange == 3) {
		$("#min_temp").text("0℃");
		$("#mid_temp").text("50℃");
		$("#max_temp").text("100℃");
		$("#min_btn").text("0℃");
		$("#max_btn").text("100℃");
	} else if (currTempRange == 4) {
		$("#min_temp").text("-10℃");
		$("#mid_temp").text("45℃");
		$("#max_temp").text("100℃");
		$("#min_btn").text("-10℃");
		$("#max_btn").text("100℃");
	} else if (currTempRange == 5) {
		$("#min_temp").text("0℃");
		$("#mid_temp").text("300℃");
		$("#max_temp").text("600℃");
		$("#min_btn").text("0℃");
		$("#max_btn").text("600℃");
	}
}

function changeTempRange() {
	currTempRange ++;
	
	if (currTempRange > 5) {
		currTempRange = 1;
	}
	var url = "";
	if (currTempRange == 1) {
		url = "http://localhost:3452/range?curr="+currTempRange+"&min=10&max=30";
	} else if (currTempRange == 2) {
		url = "http://localhost:3452/range?curr="+currTempRange+"&min=10&max=50";
	} else if (currTempRange == 3) {
		url = "http://localhost:3452/range?curr="+currTempRange+"&min=0&max=100";
	} else if (currTempRange == 4) {
		url = "http://localhost:3452/range?curr="+currTempRange+"&min=-10&max=100";
	} else if (currTempRange == 5) {
		url = "http://localhost:3452/range?curr="+currTempRange+"&min=0&max=600";
	}
	$.ajax({
	    type: 'GET',
	    url:url, 
	    cache:false,
	    async:true,
	    complete:function(data) {
			updateTempRange();
	    }, 
	    error:function(request, status, error) {
	    }
	});
}
</script>
</head>
