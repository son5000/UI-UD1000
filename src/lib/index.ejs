function drawRecTime()
{
	var now = new Date();
	var diff = Math.floor((now - recStartTime) / 10);
	
	var msec = diff % 100;
	diff = Math.floor((diff - msec)/100);
	
	var sec =  diff % 60;
	diff = Math.floor((diff - sec)/60);
	
	var min = diff % 60;

	$("#rec_time").html( padZero(min) + ":" + padZero(sec) + ":" + padZero(msec));

	if (min >= 2) {
		// 2분 이상 강제 종료
