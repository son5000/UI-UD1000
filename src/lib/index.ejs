<script>
  var canv;
  var canvHeight = 80;
  var canvWidth = 595;
  var aplot,
    previousData,
    analyser, nyquist,
    spectorgramAnimationTimer,
    spectrogramInterval;
  var canvasCtx;
  var colormap;
  var currPalette = 4;
  var currTempRange = <%-global.config.get("thermal.range")%>;
  var peakDB = 0.0;
  var dB = 0.0;
  var band = 0;
  var bCurrRecord = false;
  var recStartTime = 0;
  
  var socket = io();
  var processing = false;
  
  var FileName = "";
  var captureStep = 0;
  var currCam = -1;
  var retryCount = 0;
  var bFirstFFT = true;
  
  socket.on('filecopy',function(data) {
  	$("#transfer").html("&nbsp; "+data.curr + " / " + data.max + " files copied");
  });
  
  socket.on('filedelete',function(data) {
  	$("#transfer").html("&nbsp; "+data.curr + " / " + data.max + " files deleted");
  });
  
  socket.on('packet',function(data) {
    if (processing) return;
    bFirstFFT = false;
    processing = true;
    if (band != parseFloat(data.band)) {
      band = parseFloat(data.band);
      if (band == 0) {
        $("#leftBlur").css('display', 'none');
        $("#rightBlur").css('display', 'none');
      } else {
        if (band < 0.5) {
          band = 0.5;
          $("#leftBlur").css('display', 'none');
          $("#rightBlur").width(canvWidth - 30);
          $("#rightBlur").css('display', 'block');
        } else {
          if (band > 47.0) {
            band = 47.0;
            $("#leftBlur").width(canvWidth - 30);
            $("#leftBlur").css('display', 'block');
            $("#rightBlur").css('display', 'none');
          } else {
            $("#leftBlur").width((band - 1) * (canvWidth/48));
            $("#rightBlur").width(canvWidth - (band + 1)*(canvWidth/48));
            $("#leftBlur").css('display', 'block');
            $("#rightBlur").css('display', 'block');
          }       
        }
      }
    }
    peakDB = parseFloat(data.peak);
    dB = parseFloat(data.db);
    fft = new Uint8Array(data.fft);
    processing = false;
    updateCanvas(canv, fft);
  });
  
  function stopRecord() {
  	bCurrRecord = false;
	$("#recording").css('visibility', 'hidden');
    $.ajax({
        type: 'GET',
        url:"/stopRecord", 
        cache:false,
        async:true,
        complete:function(data) {
        	messageWindow("녹화가 끝났습니다.");
        }, 
        error:function(request, status, error) {
        }
    });
    if ($("#camera1").hasClass("down_btn")) {
    	// Vision Camera Record Stop
	    $.ajax({
	        type: 'GET',
	        url:"http://127.0.0.1:5431/stoprecord",
	        cache:false,
	        async:true,
	        complete:function(data) {}, 
	        error:function(request, status, error) {
	        }
	    });    	
    } else if ($("#camera2").hasClass("down_btn")) {
    	// Thermal Camera Record Stop
	    $.ajax({
	        type: 'GET',
	        url:"http://127.0.0.1:5432/stoprecord",
	        cache:false,
	        async:true,
	        complete:function(data) {}, 
	        error:function(request, status, error) {
	        }
	    });    	
    } else if ($("#camera3").hasClass("down_btn")) {
    	// UV Camera Record Stop
	    $.ajax({
	        type: 'GET',
	        url:"http://127.0.0.1:5433/stoprecord",
	        cache:false,
	        async:true,
	        complete:function(data) {}, 
	        error:function(request, status, error) {
	        }
	    });
    }
    
  };
  
  var recFileName = "";
  function startRecord() {
  	if ($("#modalWindow").css('visibility') === "visible") {
  		return;
  	}
  	var dt= new Date();
	$("#recording").css('visibility', 'visible');
	
	recFileName = dt.getFullYear()+padZero(dt.getMonth()+1)+padZero(dt.getDate())+"_"
        	+ padZero(dt.getHours())+padZero(dt.getMinutes())+padZero(dt.getSeconds());
	
	// FFT(Node) & Audio(Teensy) Save
    $.ajax({
        type: 'GET',
        url:"/startRecord?fName="+recFileName,
        cache:false,
        async:true,
        complete:function(data) {
        	if (data.responseText.indexOf("ERR")>=0) {
        		stopRecord();
        		console.log("Recording Start Failed");
        	} else {
			  	bCurrRecord = true; 	
	        	recStartTime = new Date();
	        	drawRecTime();
	        	saveRecord(recFileName);
	        }
        }, 
        error:function(request, status, error) {
        }
    });
}

function checkSnapDone(url)
{
	$.ajax({
	    type: 'GET',
	    url:url+"?time="+new Date().getTime(),
	    cache:false,
	    async:true,
	    complete:function(data) {
	    	if (data.responseText.indexOf("FALSE")>=0) {
		    	console.log("Wait Capture");
	    		setTimeout("checkSnapDone('"+url+"')",200);
	    	} else {
		    	console.log("Capture Done");
	    		captureStep++;
	    		setTimeout("captureAllCamera()",100);
	    	}
	    }, 
	    error:function(request, status, error) {
	    	messageWindow("저장 오류");
	    }
	});
}

