  function spectDataToImageData(newData,ctx){
    var imgData = ctx.getImageData(0, 0, canvWidth-1, 1);   
    var fftSize = newData.byteLength;    // 512 ea
    var fRatio = parseFloat(canvWidth) / parseFloat(fftSize);
    for (var i = 0; i < canvWidth; i ++) {
      var iPos = Math.round( i / fRatio );
      var dt = newData[iPos];
      if (dt < 0) {
        console.log(dt);
      }
      imgData.data[i*4 + 0] = colormap.red[dt];
      imgData.data[i*4 + 1] = colormap.green[dt];
      imgData.data[i*4 + 2] = colormap.blue[dt];
      imgData.data[i*4 + 3] = 255;
    }
    return imgData;
  }

  function updateCanvas(ctx, newData) {
    if (previousData === undefined) previousData=newData;
    // get previous canvas data 
    var imgData = ctx.getImageData(0, 0, canvWidth-1, canvHeight - 1);
    // shift previous canvas content along 
    ctx.putImageData(imgData, 0, 1);
    // add new data
    ctx.putImageData(spectDataToImageData(newData,ctx), 0, 0);
    previousData=newData;
  }
  
  function linspace(start, stop, num) {
    const div = num;
    const step = (stop - start) / div;
    return Array.from({length: num}, (_, i) => start + step * i);
  }
  

  function setupColorMap() {
    colormap = new Object();
    colormap.red = new Uint8Array(256);
    colormap.green = new Uint8Array(256);
    colormap.blue = new Uint8Array(256);
    
/*
  0        0   0   0
 32        0   0  16
 64        0   0  
 96   96   0   0 255
160   64   0 255 255
192   32 128 255 128
224   32 255 255   0
256   32 255 255 255
*/

    for (var i=0; i<160; i++) {  
      colormap.red[i] = 0;
    }
    for (var i=160; i<224; i++) {
      colormap.red[i] = (i-160)*4;
    }
    for (var i=224; i<256; i++) {
      colormap.red[i] = 255;
    } 


    for (var i=0; i<96; i++) {  
      colormap.green[i] = 0;
    }
    for (var i=96; i<160; i++) { 
      colormap.green[i] = (i-96)*4;
    }
    for (var i=160; i<256; i++) {
      colormap.green[i] = 255;
    }

    for (var i=0; i<32; i++) {
      colormap.blue[i] = i*0.5;
    }
    for (var i=32; i<64; i++) {
      colormap.blue[i] = 16+(i-32);
    }
    for (var i=64; i<96; i++) {
      colormap.blue[i] = 48+(i-64)*6.5;
    }
    for (var i=96; i<160; i++) { 
      colormap.blue[i] = 255;
    }
    for (var i=160; i<224; i++) {
      colormap.blue[i] = 255-(i-160)*4;
    }
    for (var i=225; i<256; i++) {
      colormap.blue[i] = (i - 225)*8;
    }

  }

  function setupColorMap2() {
    colormap = new Object();
    colormap.red = new Uint8Array(256);
    colormap.green = new Uint8Array(256);
    colormap.blue = new Uint8Array(256);
    
    // jet map 
    for (var i=0; i<96; i++) {  // 0 ~ 96
      colormap.red[i] = 0;
    }
    for (var i=0; i<64; i++) {  // 96 ~ 159
      colormap.red[i+96] = i*4;
    }
    for (var i=0; i<64; i++) {  // 160 ~ 223
      colormap.red[i+96+64] = 255;
    } 
    for (var i=0; i<32; i++) {  // 224 ~ 255
      colormap.red[i+96+128] = 255 - i * 4;
    }

    for (var i=0; i<32; i++) {  // 0 ~ 32
      colormap.blue[i] = i*4;
    }
    for (var i=0; i<64; i++) {  // ~ 96
      colormap.blue[i+32] = 255;
    }
    for (var i=0; i<64; i++) {  // ~ 160
      colormap.blue[i+32+64] = 255-i*4;
    }
    for (var i=0; i<96; i++) {  // ~ 256
      colormap.blue[i+32+128] = 0;
    }

    for (var i=0; i<96; i++) {  // 0 ~ 96
      colormap.green[i] = i*2.6;
    }
    for (var i=0; i<64; i++) {  // ~ 160
      colormap.green[i+96] = 255;
    }
    for (var i=0; i<64; i++) {  // ~ 224
      colormap.green[i+32+128] = 255-i*4;
    }
    for (var i=0; i<32; i++) {  // ~ 256
      colormap.green[i+32+192] = 0;
    }

  }

