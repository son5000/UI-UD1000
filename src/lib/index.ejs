function drawTemperature()
{
	if ($("#modalWindow").css('visibility') === "visible") {
	    setTimeout("drawTemperature()",800);
		return;
	}

	// 640 x 512  ==>  800 x 640 
	// X : 800 = 17 + 85 + 595 + 103 : Center = 17 + 85 + 595/2
	// Y : 640 = 120 + 400 + 120 : Center
	// ViewPort = 595 x 400  => 298 x 200
	// 85 |  595  | 85 ==> ( x= -17 ) 17 + 85 | 595 | 85 (102 - 17)

	var ratio = 640.0 / 800.0;
	var centerX = parseInt((85 + 298 - $("#main_thermal").position().left) * ratio);
	var centerY = parseInt((200 - $("#main_thermal").position().top) * ratio);
	var url = "http://127.0.0.1:5432/getTemperature";
    $.ajax({
        type: 'GET',
        url:url, 
        data:{x:centerX, y:centerY},
        cache:false,
        async:true,
        complete:function(data) {
          if (data.responseText) {
          	if (data.responseText.startsWith("<")) {
          		// Error
	            console.log("message: " + data.responseText);
	            setTimeout("drawTemperature()",30000);
          	} else {
	            var temp = data.responseText.split("/");
	            
	            if (temp.length == 4) {
		            var temp_c   = Math.trunc(parseFloat(temp[0])*10)/10;
		            var temp_min = Math.trunc(parseFloat(temp[1])*10)/10;
		            var temp_max = Math.trunc(parseFloat(temp[2])*10)/10;
		            var temp_avg = Math.trunc(parseFloat(temp[3])*10)/10;
		            
	                var strTemp = "";
	                var temp_int = Math.trunc(temp_c);
	                var temp_dec = Math.trunc(Math.abs(temp_c - temp_int)*10);
	                
	                strTemp = temp_int+"<small>."+temp_dec+"℃</small>";
		            $($("#temperature>div.info_value>span")[0]).html(strTemp);                
		            
		            strTemp = temp_min+"℃ &nbsp; "+temp_max+"℃";
		            $($("#temperature div.info_sub>span")[0]).html(strTemp);                
		            
		            setTimeout("drawTemperature()",800);
				} else {
		            setTimeout("drawTemperature()",2000);
				}
			}
		  } else {
            setTimeout("drawTemperature()",2000);
		  }
        }, 
        error:function(request, status, error) {
            console.log("message: " + request.responseText);
            setTimeout("drawTemperature()",30000);
        }
    });
}

