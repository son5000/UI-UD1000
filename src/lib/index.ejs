function getPalette()
{
	var currCamera = getCurrCamera();
	var url = "";

	url = "/palette?cam="+currCamera;

    $.ajax({
        type: 'GET',
        url:url, 
        cache:false,
        async:true,
        complete:function(data) {
        	if (data.responseText) {
        		$($("#colormap > img")[0]).attr("src", "/images/colormap/"+data.responseText+".jpg");
       			currPalette = parseInt(data.responseText);
        	}
        }, 
        error:function(request, status, error) {
        }
    });
}

function changePalette()
{
	var currCamera = getCurrCamera();
	
	currPalette ++;
	if (currPalette > 22) currPalette = 1;

	var url = "";
	url = "/palette?cam="+currCamera + "&pal="+currPalette;
    $.ajax({
        type: 'GET',
        url:url, 
        cache:false,
        async:true,
        complete:function(data) {
        	if (data.responseText) {
        		$($("#colormap > img")[0]).attr("src", "/images/colormap/"+data.responseText+".jpg");
    			currPalette = parseInt(data.responseText);
        	}
        }, 
        error:function(request, status, error) {
        }
    });
	
}

var CaliCamera = "";

  socket.on('button',function(data) {
  	if ($("#modalWindow").css('visibility') === "visible" && !bCaliMode) {
  		// Ignore All Button 
  	} else if (bCurrRecord) {
  		// Ignore All Button Until Record Done
  		if (data.button == '7') {
			stopRecord();
  		}
  	} else {
		if (data.button == '8') {
			if ($("#modalWindow").css('visibility') !== "visible") {
				if (captureStep == 0) {
					var dt= new Date();
					FileName = dt.getFullYear()+padZero(dt.getMonth()+1)+padZero(dt.getDate())+"_"
				    	+ padZero(dt.getHours())+padZero(dt.getMinutes())+padZero(dt.getSeconds());
		
					// Capture All Camera
					captureStep = 1;
					setTimeout("captureAllCamera()",10);
				}
			}
	    } else if (data.button == '7') {
			if ($("#modalWindow").css('visibility') !== "visible") {
				// Record 
				if (bCurrRecord) {
					stopRecord();
				} else {
					startRecord();
				}      
			}
	    } else if (data.button == '6') {
	      // Up
	      if (bCaliMode) {
	      	if (CaliCamera === "THERMAL") {
	      		$("#main_thermal").css('top', ($("#main_thermal").offset().top + 10)+'px');
	      	}else if (CaliCamera === "UV") {
	      		$("#main_uv").css('top', ($("#main_uv").offset().top + 10)+'px');
	      	} else {
	      		$("#main_video").css('top', ($("#main_video").offset().top + 10)+'px');
	      	}
	      } else {
	      	var currCamera = getCurrCamera();
	      	if (currCamera === "VISION") {
	      		camInit(2);
	      	} else if (currCamera === "THERMAL") {
	      		camInit(0);
	      	} else if (currCamera === "UV") {
	      		camInit(1);
	      	}
	      }
	    } else if (data.button == '5') {
	      // Left
	      if (bCaliMode) {
	      	if (CaliCamera === "THERMAL") {
		      $("#main_thermal").css('left', ($("#main_thermal").offset().left + 10)+'px');
	      	} else if (CaliCamera === "UV") {
	      		$("#main_uv").css('left', ($("#main_uv").offset().left + 10)+'px');
		    } else {
		      $("#main_video").css('left', ($("#main_video").offset().left + 10)+'px');
		    }
		  }
	    } else if (data.button == '4') {
	      // OK
	      var currCamera = getCurrCamera();
	      if (bCaliMode) {
	      	saveCalibrationWindow();
		  } else if (currCamera === "THERMAL" || currCamera === "UV") {
		    changePalette();
		  }
	    } else if (data.button == '3') {
	      // Right
	      if (bCaliMode) {
	      	if (CaliCamera === "THERMAL") {
		        $("#main_thermal").css('left', ($("#main_thermal").offset().left - 10)+'px');
